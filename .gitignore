# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo

# Logs and temporary files
*.log
*.tmp
*.temp

# Python cache, useful if helper scripts are added later
__pycache__/
*.py[cod]
.pytest_cache/

# Node cache, useful if tooling is added later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local Codex output generated by users of the skill
.codex/
